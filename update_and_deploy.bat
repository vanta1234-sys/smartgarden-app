@echo off
chcp 65001 >nul
color 0A
title SmartGarden.gr 1-Click Auto Sync & Deploy

echo ========================================================
echo   SMARTGARDEN.GR 1-CLICK AUTO SYNC & DEPLOY
echo ========================================================
echo.

cd /d "%~dp0"
set "JSON_FILE=%~dp0public\latest_articles.json"

echo [1/3] Enimerosi tou public\latest_articles.json...

powershell -NoProfile -Command "[System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String('')) | Out-File -FilePath '%JSON_FILE%' -Encoding utf8"

if exist "%JSON_FILE%" (
    echo [OK] To public\latest_articles.json enimerothike epitixos!
) else (
    echo [ERROR] Apotyxia sto %JSON_FILE%
)

echo.
echo [2/3] Ektelesi Build (npm run build)...
call npm run build

echo.
echo [3/3] FTP Upload meso Node.js...
node deploy.js

echo.
echo ========================================================
echo   DONE! Site updated: https://smartgarden.gr
echo ========================================================
echo.
pause
